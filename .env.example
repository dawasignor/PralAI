# ===========================================================================
# Model slots -- deliberately generic names. No agent references a provider
# or a model id directly; they reference a SLOT (1 = primary, 2 = cheap).
#
# Provider: OpenRouter (OpenAI-compatible /v1). Get a key at
# https://openrouter.ai/keys -- it is the only thing you need to fill in.
# ===========================================================================

# --- Slot 1: primary reasoning model --------------------------------------
MODEL_1_PROVIDER=openrouter
LLM_MODEL_1=deepseek/deepseek-v4-pro
MODEL_1_API_KEY=
MODEL_1_BASE_URL=
MODEL_1_MAX_TOKENS=16000
MODEL_1_EFFORT=high

# --- Slot 2: cheap / high-volume model ------------------------------------
# Nothing uses slot 2 yet. Point an agent at it with `model_slot: 2` in its
# agents.md frontmatter.
MODEL_2_PROVIDER=openrouter
LLM_MODEL_2=deepseek/deepseek-v4-flash-0731
# Left blank, slot 2 inherits MODEL_1_API_KEY (same provider = same account).
MODEL_2_API_KEY=
MODEL_2_BASE_URL=
MODEL_2_MAX_TOKENS=8000
MODEL_2_EFFORT=medium

# --- Reasoning effort ------------------------------------------------------
# 1 sends {"reasoning": {"effort": MODEL_n_EFFORT}} to OpenRouter; 0 or auto
# sends nothing and the model uses its own default. Reasoning tokens count
# against MODEL_n_MAX_TOKENS.
MODEL_1_REASONING=auto

# --- Sampling and provider routing (RQ5, 2026-11-11) ------------------------
# Temperature sent on every call. Blank = 1.0 (DeepSeek's recommended value);
# `none` sends nothing and the serving provider uses its own default.
MODEL_1_TEMPERATURE=
# Pin OpenRouter providers, in order, by their tag on the model's Providers
# page (e.g. deepinfra/fp8). Blank = OpenRouter chooses per request. A pin
# turns fallbacks off unless MODEL_1_ALLOW_FALLBACKS=1, and requires the
# provider to honour every parameter sent (the temperature included).
MODEL_1_PROVIDER_ORDER=
MODEL_1_ALLOW_FALLBACKS=
# Restrict precision, e.g. fp8. Blank = any.
MODEL_1_QUANTIZATIONS=
# 1 opens every system prompt with the run id, so no two runs share a cached
# prompt prefix. scripts/run_n.py sets it for a batch (--no-run-token to skip).
PROMPT_RUN_TOKEN=0

# --- Optional OpenRouter attribution --------------------------------------
# Shown on openrouter.ai activity; harmless when unset.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=

# MODEL_n_BASE_URL is optional -- blank uses OpenRouter's default.

# --- Runtime -------------------------------------------------------------
GRAPH_MAX_STEPS=8          # hard stop on orchestrator <-> specialist hops
MONTY_MAX_RETRIES=2        # retries after a Monty failure (2 = 3 attempts total)
MEMORY_WRITE=1             # 1 = agents append to their memory.md, 0 = off
LOG_LEVEL=INFO

# --- Exchange log ---------------------------------------------------------
# One line per exchange between agents. See core/logbook.py.
EXCHANGE_LOG=logs/exchange.log   # path, or "off" to disable the file
EXCHANGE_LOG_ECHO=1              # 1 = also print each line to stdout

# --- Monty ----------------------------------------------------------------
# Workflows run in-process from core/workflows/. No sandbox, no MCP server.
# fetch_weather_data calls Open-Meteo, which needs no key.

# ---------------------------------------------------------------------------
# Obsidian vault (read-only)
# ---------------------------------------------------------------------------
# The knowledge and sources notes the Citadel flows retrieve. Read by
# core/vault.py and served by mcp_servers/vault_server.py. Nothing writes here.
# Replace <VAULT_ROOT> with the absolute path of your clone of the knowledge
# vault (see README, "Placeholders").
VAULT_ROOT=<VAULT_ROOT>

# Cap on a single note, in characters. A longer note is truncated and the
# response says so -- a truncated note is never returned silently.
# VAULT_MAX_CHARS=40000

# ---------------------------------------------------------------------------
# NASA Earthdata (OPERA DSWx downloads)
# ---------------------------------------------------------------------------
# An Earthdata user token (urs.earthdata.nasa.gov > Generate Token), sent as
# "Authorization: Bearer <token>" by core/workflows/opera.py. get_flood_map
# needs it to read OPERA DSWx-HLS / DSWx-S1; without it OPERA is NOT KNOWN.
EARTHDATA_TOKEN=
