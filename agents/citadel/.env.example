# Overrides for the citadel agent only. Loaded AFTER the repo-root .env
# (see core/config.py::load_agent_env), so anything set here wins.
# Copy to .env and uncomment what you need. Leave it empty to inherit.

# --- point this agent at a different model or slot -----------------------
# LLM_MODEL_1=deepseek/deepseek-v4-pro
# MODEL_1_API_KEY=
# MODEL_1_BASE_URL=
# MODEL_1_MAX_TOKENS=16000
# MODEL_1_EFFORT=high        # low | medium | high | xhigh | max

# --- stop this agent writing to memory.md --------------------------------
# MEMORY_WRITE=0

# --- decision support ----------------------------------------------------
# VAULT_ROOT=<VAULT_ROOT>
# MCDM_METHOD=weighted_sum # weighted_sum | topsis | ahp
# CRITERIA_NOTE=           # vault-relative path to the criteria/weights note
